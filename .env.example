# API Keys (Required)
GROQ_API_KEY=your_groq_api_key_here
BEARER_TOKEN=your_bearer_token_here

# LLM Configuration
LLM_MODEL=llama3-8b-8192

# Database Configuration (Required)
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432
DB_TABLE=document_chunks

# Performance Optimization Settings
BATCH_SIZE=32                # Embedding batch size (higher = faster but more memory)
CACHE_SIZE=5000             # LRU cache size for embeddings
USE_GPU=true                # Enable GPU acceleration (requires CUDA)
USE_FAISS=false             # Use FAISS instead of pgvector for vector search
TOP_K_CHUNKS=5              # Number of chunks to retrieve per query

# Connection Pool Configuration
DB_POOL_MIN=2               # Minimum database connections
DB_POOL_MAX=10              # Maximum database connections

# Chunking Configuration
CHUNK_SIZE=512              # Maximum tokens per chunk
CHUNK_OVERLAP=50            # Number of overlapping tokens between chunks
MIN_CHUNK_LENGTH=10         # Minimum chunk size in tokens

# PDF Processing
PDF_FOLDER=pdfs             # Folder for PDF files

# Embedding Configuration
EMBEDDING_DIM=384           # Dimension of embedding vectors (384 for e5-small-v2)

# Optional: For distributed caching (if using Redis)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
